---
import type { Language } from "../../data/products";
import { twort } from "../../data/twort";

interface Props { lang: Language; }
const desktopMenu: readonly string[] = twort[Astro.props.lang].desktopMenu;
---
<div class="desktop">
  <div class="menubar">
    <strong>Finder</strong>
    {desktopMenu.map(label => <span>{label}</span>)}
    <div class="status">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
        <path d="M1.5 5.5a10.2 10.2 0 0 1 13 0M3.75 8a6.5 6.5 0 0 1 8.5 0M6 10.5a3 3 0 0 1 4 0M8 13h.01" />
      </svg>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
        <circle cx="6.75" cy="6.75" r="3.75" /><path d="m9.5 9.5 3.5 3.5" />
      </svg>
      <time datetime="09:41">9:41</time>
    </div>
  </div>
</div>

<style>
  .desktop {
    container-type: inline-size;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    position: relative;
    overflow: hidden;
    color-scheme: light dark;
    background: var(--desktop-wallpaper, url("/twort/coast-study.webp")) center / cover no-repeat #153e49;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  }
  .menubar {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 1.4cqi;
    height: 2.1cqi;
    padding-inline: 1.7cqi;
    background: light-dark(rgb(242 247 245 / 70%), rgb(19 30 37 / 65%));
    color: light-dark(#1e282e, #f2f6f5);
    backdrop-filter: blur(4px) saturate(1.25);
    box-shadow: 0 1px 0 rgb(10 18 24 / 12%);
    font-size: 1cqi;
    line-height: 1;
    white-space: nowrap;
  }
  .menubar strong { font-weight: 650; }
  .status { display: flex; align-items: center; gap: 1.1cqi; margin-inline-start: auto; }
  .status svg { width: 1.2cqi; height: 1.2cqi; }
  .status time { font-variant-numeric: tabular-nums; }
</style>
