---
import type { Language } from "../../data/products";
import { twort } from "../../data/twort";

interface Props { lang: Language; }
const t = twort[Astro.props.lang].desktop;
---
<div class="desktop">
  <img class="wallpaper" src="/twort/coast-study.webp" width="1440" height="960" alt="" />
  <div class="menubar">
    <strong>{t.notes}</strong><span>{t.file}</span><span>{t.edit}</span><span>{t.view}</span>
    <time>9:41</time>
  </div>
  <div class="note">
    <div class="note-bar"><i></i><i></i><i></i></div>
    <div class="note-content">
      <strong>{t.title}</strong>
      <p>{t.body}</p>
      <div class="swatches"><i></i><i></i><i></i><i></i></div>
      <small>{t.palette}</small>
    </div>
  </div>
</div>

<style>
  .desktop {
    container-type: inline-size;
    width: 100%;
    aspect-ratio: 16 / 10;
    position: relative;
    overflow: hidden;
    color-scheme: light dark;
    background: #286b74;
    color: light-dark(#303531, #f2f4ec);
    text-align: left;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  }
  .wallpaper { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .menubar {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 2cqi;
    padding: 0.65cqi 2.2cqi;
    background: light-dark(rgb(23 43 45 / 42%), #101619ad);
    color: white;
    font-size: 1.28cqi;
    line-height: 1;
  }
  .menubar time { margin-left: auto; font-variant-numeric: tabular-nums; }
  .note {
    position: absolute;
    left: 7.5%;
    top: 23%;
    width: 33%;
    overflow: hidden;
    border-radius: 1.3cqi;
    background: light-dark(#fffdf6, #282c29);
    box-shadow: 0 1.6cqi 3.5cqi #142e3440, 0 0 0 0.1cqi #28312b24;
  }
  .note-bar { display: flex; gap: 0.6cqi; padding: 1.3cqi 1.5cqi; background: light-dark(#f4f0e6, #343834); }
  .note-bar i { width: 0.85cqi; height: 0.85cqi; border-radius: 50%; background: #e68977; }
  .note-bar i:nth-child(2) { background: #e7bd65; }
  .note-bar i:nth-child(3) { background: #84ac89; }
  .note-content { padding: 2.2cqi 2.4cqi 2cqi; font-size: 1.45cqi; line-height: 1.35; }
  .note-content strong { font-size: 3.2cqi; font-weight: 650; letter-spacing: -0.05em; }
  .note-content p { font-size: 1.45cqi; margin: 0.55cqi 0 1.7cqi; color: light-dark(#303531, #ccd1c8); }
  .swatches { display: flex; gap: 0.45cqi; }
  .swatches i { width: 3.3cqi; height: 3.3cqi; background: #176569; border-radius: 0.4cqi; }
  .swatches i:nth-child(2) { background: #7ba599; }
  .swatches i:nth-child(3) { background: #d9b382; }
  .swatches i:nth-child(4) { background: #ac734b; }
  .note-content small { display: block; margin-top: 0.7cqi; font-size: 1.12cqi; color: light-dark(#65645b, #b1bbaf); }
</style>
