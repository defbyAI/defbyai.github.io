---
import type { Language } from "../../data/products";
import { displays, enclosure, mm } from "../../lib/zeropl/fold-preview-geometry";
import DesktopScene from "./DesktopScene.astro";
import DuoLandscapeScreen from "./DuoLandscapeScreen.astro";

interface Props { lang: Language; }
const { lang } = Astro.props;
const ko = lang === "ko";
const monitorAspect = 16 / 10;
const monitorPanelWidth = mm(21.5 * 25.4) * monitorAspect / Math.hypot(monitorAspect, 1);
const duoPanel = displays.inner;
const duoPanelCorner = enclosure.corner - (enclosure.width - duoPanel.width) / 2;
const cornerRadius = (radius: number, { width, height }: { width: number; height: number }) =>
  `${radius / width * 100}% / ${radius / height * 100}%`;
const deviceDimensions = {
  "--monitor-aspect": monitorAspect,
  "--duo-width-ratio": enclosure.width / monitorPanelWidth,
  "--duo-aspect": enclosure.width / enclosure.height,
  "--duo-radius": cornerRadius(enclosure.corner, enclosure),
  "--duo-display-width": `${duoPanel.width / enclosure.width * 100}%`,
  "--duo-display-height": `${duoPanel.height / enclosure.height * 100}%`,
  "--duo-display-radius": cornerRadius(duoPanelCorner, duoPanel),
};
const modes = [
  {
    id: "phone", label: ko ? "iPhone만" : "iPhone Only",
    description: ko ? "왼쪽 iPhone Duo에 Mac 화면과 조작 버튼이 표시됩니다. 오른쪽 모니터에는 현재 모드가 표시됩니다."
      : "Your Mac desktop and session controls appear on the iPhone Duo at left. The monitor shows which mode is active.",
  },
  {
    id: "mirror", label: ko ? "미러링" : "Mirror",
    description: ko ? "두 화면에 같은 Mac 데스크톱이 보입니다. 조작 버튼은 iPhone Duo에만 표시됩니다."
      : "Both screens show the same Mac desktop. Session controls stay on iPhone Duo.",
  },
  {
    id: "monitor", label: ko ? "외장 디스플레이만" : "External Display Only",
    description: ko ? "Mac 데스크톱을 오른쪽 모니터에 띄웁니다. 왼쪽 iPhone Duo를 트랙패드로 쓰거나 화면 키보드로 입력할 수 있습니다."
      : "See your Mac desktop on the monitor at right. Use the iPhone Duo at left as a trackpad or open its keyboard to type.",
  },
  {
    id: "extend", label: ko ? "확장 디스플레이" : "Extended Display",
    description: ko ? "원격으로 Mac을 쓸 때도 모니터 한 대를 더 연결해 두 화면에 다른 창을 띄울 수 있습니다."
      : "Use an extra monitor while connected to your Mac remotely, with different windows on each screen.",
  },
] as const;
---
<section id="displays" class="display-feature" aria-labelledby="displays-title">
  <div class="container">
    <header class="intro">
      <h2 id="displays-title">{ko ? "Mac 작업 공간을 두 화면으로." : "Your Mac workspace on two screens."}</h2>
      <p class="section-body">
        {ko
          ? "iPhone에 USB-C로 모니터를 연결하세요. 세션 메뉴에서 ‘외장 디스플레이’를 열고 Mac의 작업 공간을 어디에 띄울지 선택할 수 있습니다."
          : "Connect a monitor to your iPhone with USB-C. Open External Display in the session menu to choose where your Mac workspace appears."}
      </p>
      <p class="connection-note">
        {ko ? "(USB-C 유선 연결이 필요합니다.)" : "(A wired USB-C connection is required.)"}
      </p>
    </header>
    <figure class="display-demo" style={deviceDimensions}>
      <fieldset class="mode-picker" aria-label={ko ? "디스플레이 모드" : "Display mode"}>
        <div class="choices">
          {modes.map(mode => (
            <label>
              <input type="radio" name="display-mode" value={mode.id} checked={mode.id === "extend"}
                aria-describedby={`display-detail-${mode.id}`} />
              <span>{mode.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="stage" aria-hidden="true">
        <div class="devices">
          <div class="phone-device">
            <div class="phone-shell">
              <div class="duo-display">
                <DuoLandscapeScreen lang={lang} />
                <div class="phone-desktop"><DesktopScene lang={lang} /></div>
                <div class="inactive phone-inactive">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="2" y="3.5" width="20" height="14" rx="2" /><path d="M12 18v3m-4 0h8" />
                  </svg>
                  <span>{modes[2].label}</span>
                </div>
                <div class="phone-tools"><b>•••</b><i></i></div>
              </div>
            </div>
            <span class="device-name">iPhone Duo</span>
          </div>
          <div class="external-device">
            <div class="monitor-shell">
              <div class="monitor-screen">
                <div class="monitor-desktop"><DesktopScene lang={lang} /></div>
                <div class="inactive monitor-inactive">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="6.5" y="1.5" width="11" height="21" rx="2.5" /><path d="M10 4h4m-3.5 16h3" />
                  </svg>
                  <span>{modes[0].label}</span>
                </div>
              </div>
            </div>
            <div class="monitor-stand"></div>
            <span class="device-name">{ko ? "외장 모니터" : "External monitor"}</span>
          </div>
        </div>
      </div>

      <figcaption>
        {modes.map(mode => (
          <p class={`detail detail-${mode.id}`} id={`display-detail-${mode.id}`}>{mode.description}</p>
        ))}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .display-feature {
    padding-block: clamp(58px, 7vw, 100px);
    border-block: 1px solid var(--line);
    background: var(--color-surface);
  }
  .intro { text-align: center; }
  h2 { margin-bottom: 14px; text-wrap: balance; }
  .intro .section-body { max-width: 610px; margin: 0 auto; text-wrap: balance; }
  .connection-note { margin: 6px 0 0; color: var(--muted); font-size: 12px; line-height: 1.5; }
  .display-demo { max-width: 920px; margin: 30px auto 0; }
  fieldset { min-width: 0; margin: 0; border: 0; padding: 0; text-align: center; }
  .choices { display: inline-grid; grid-auto-flow: column; gap: 2px; padding: 3px; border: 1px solid #becbc4; border-radius: 25px; background: var(--color-bg); }
  label { position: relative; cursor: pointer; }
  input {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip-path: inset(50%); margin: 0; padding: 0; white-space: nowrap;
  }
  label span { display: grid; place-items: center; min-height: 42px; border-radius: 22px; padding: 6px 15px; color: #4b5752; font-size: 14px; line-height: 1.3; }
  label:hover span { background: var(--color-control); }
  input:checked + span { background: var(--color-accent-2-active); color: white; }
  input:focus-visible + span { outline: 2px solid var(--color-accent-2); outline-offset: 2px; }

  .stage { container-type: inline-size; margin: 30px auto 12px; }
  .devices {
    --duo-column-width: 33cqi;
    --device-column-gap: 5.3cqi;
    --monitor-width: 53cqi;
    --monitor-padding: 0.7cqi;
    --monitor-border: max(1px, 0.24cqi);
    --monitor-panel-width: calc(var(--monitor-width) - 2 * (var(--monitor-padding) + var(--monitor-border)));
    --duo-width: calc(var(--monitor-panel-width) * var(--duo-width-ratio));
    --device-shadow: 0 1.2cqi 1.6cqi -1.1cqi #2d3c344f;
    display: grid;
    grid-template-columns: var(--duo-column-width) var(--monitor-width);
    justify-content: center;
    justify-items: center;
    align-items: end;
    column-gap: var(--device-column-gap);
  }
  .phone-device {
    position: relative;
    width: var(--duo-width);
    /* The visible gap includes the unused half of the Duo column on its right. */
    inset-inline-start: calc((var(--device-column-gap) + (var(--duo-column-width) - var(--duo-width)) / 2) * .2);
  }
  .external-device { width: 100%; min-width: 0; }
  .phone-shell, .monitor-shell {
    position: relative; isolation: isolate; overflow: hidden; color: #b1b4b3; background: #101211;
  }
  .phone-shell {
    aspect-ratio: var(--duo-aspect);
    border-radius: var(--duo-radius);
    box-shadow: inset 0 0 0 max(1px, .16cqi) #454a48, var(--device-shadow);
  }
  .duo-display {
    position: absolute; inset: 0; margin: auto;
    display: grid; place-items: center; container-type: inline-size; overflow: hidden;
    width: var(--duo-display-width); height: var(--duo-display-height);
    border-radius: var(--duo-display-radius);
  }
  .duo-display :global(.duo-screen) { width: 100%; height: 100%; }
  .duo-display :global(.duo-screen img) { height: 100%; object-fit: contain; }
  .phone-desktop { display: none; width: 100%; overflow: hidden; }
  .phone-tools {
    position: absolute; right: 2cqi; bottom: 3cqi;
    display: none; justify-items: center; gap: 2cqi; padding: 2cqi 1.5cqi;
    border-radius: 4cqi; background: #282d2deb; color: white; font: bold 3cqi/1 sans-serif;
  }
  .phone-tools i { width: 4.4cqi; height: 2.8cqi; border: 0.5cqi solid currentColor; border-radius: 0.6cqi; }
  .monitor-shell {
    display: grid;
    aspect-ratio: var(--monitor-aspect);
    padding: var(--monitor-padding);
    border: var(--monitor-border) solid transparent;
    border-radius: max(3px, 0.9cqi);
    background: linear-gradient(160deg, #262c2e, #131719 68%, #1d2224) padding-box,
      linear-gradient(145deg, #738084, #384043 38%, #2c3134 66%, #626b6d) border-box;
    box-shadow: inset 0 0 0 max(0.5px, 0.1cqi) #ced9dd2e, inset 0 -0.24cqi #080b0d,
      0 0.35cqi 0.75cqi #1a24282b, var(--device-shadow);
  }
  .monitor-shell::after {
    content: "";
    position: absolute;
    right: 1.35cqi;
    bottom: 0.18cqi;
    width: max(1px, 0.25cqi);
    height: max(0.5px, 0.1cqi);
    border-radius: 100px;
    background: #adcfcd;
    box-shadow: 0 0 0.26cqi #9bc5c47d;
  }
  .monitor-screen {
    position: relative;
    overflow: hidden;
    border-radius: max(1px, 0.23cqi);
    background: #0d1012;
    box-shadow: 0 0 0 max(0.5px, 0.1cqi) #090c0d;
  }
  .monitor-screen::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(128deg, #f5fcff13, transparent 52%);
    pointer-events: none;
  }
  .monitor-desktop { position: absolute; inset: 0; }
  .monitor-stand {
    position: relative;
    width: 33%;
    height: 3.9cqi;
    margin-inline: auto;
    filter: drop-shadow(0 0.3cqi 0.28cqi #293a4066);
  }
  .monitor-stand::before,
  .monitor-stand::after { content: ""; position: absolute; }
  .monitor-stand::before {
    inset: 0 28% 12%;
    background: linear-gradient(180deg, #253034a8, transparent 58%),
      linear-gradient(100deg, #7c898b 4%, #bdc7c6 18%, #dde3e1 58%, #899699 100%);
    clip-path: polygon(11% 0, 89% 0, 100% 100%, 0 100%);
  }
  .monitor-stand::after {
    inset: 70% 0 0;
    border-radius: 0.2cqi;
    background: linear-gradient(#bcc7c9, #a0adaf 64%, #d3dcda 68%, #859395 80%, #626e71);
    clip-path: polygon(20% 0, 80% 0, 100% 69%, 100% 100%, 0 100%, 0 69%);
  }
  .device-name { display: block; margin-top: 0.8cqi; text-align: center; white-space: nowrap; font-size: clamp(11px, 1.6cqi, 14px); color: #52615a; }
  .inactive { position: absolute; inset: 0; display: none; align-content: center; justify-items: center; gap: 0.6cqi; }
  .inactive svg { width: 3cqi; height: 3cqi; }
  .inactive span { font-size: 1.4cqi; }
  .phone-inactive { gap: 2.5cqi; }
  .phone-inactive svg { width: 9cqi; height: 9cqi; }
  .phone-inactive span { font-size: 5cqi; }
  figcaption { text-align: center; }
  .detail { display: none; margin: 0 auto; max-width: 650px; font-size: 16px; line-height: 1.7; text-wrap: balance; }
  .display-demo:has([value="phone"]:checked) .detail-phone,
  .display-demo:has([value="mirror"]:checked) .detail-mirror,
  .display-demo:has([value="mirror"]:checked) .phone-desktop,
  .display-demo:has([value="monitor"]:checked) .detail-monitor,
  .display-demo:has([value="extend"]:checked) .detail-extend { display: block; }
  .display-demo:has([value="phone"]:checked) .monitor-inactive,
  .display-demo:has([value="monitor"]:checked) .phone-inactive,
  .display-demo:has([value="mirror"]:checked, [value="monitor"]:checked) .phone-tools { display: grid; }
  .display-demo:has([value="mirror"]:checked, [value="monitor"]:checked) .duo-display :global(.duo-screen),
  .display-demo:has([value="phone"]:checked) .monitor-desktop { display: none; }
  .display-demo:has([value="monitor"]:checked, [value="extend"]:checked) .monitor-desktop {
    --desktop-wallpaper: url("/twort/chalk-coast.webp");
  }

  @media (max-width: 760px) {
    .devices { --monitor-width: 60cqi; --device-column-gap: 4.5cqi; }
    .stage { margin-top: 24px; }
  }
  @media (max-width: 610px) {
    .mode-picker .choices { grid-auto-flow: row; grid-template-columns: 1fr 1fr; border-radius: 17px; }
    .mode-picker label span { border-radius: 13px; }
    .detail { font-size: 15px; }
  }
</style>
