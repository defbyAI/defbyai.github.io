---
import type { Language } from "../../data/products";

interface Props { lang: Language; }
const { lang } = Astro.props;
const ko = lang === "ko";
const features = [
  {
    icon: "M11 5 6 9H3v6h3l5 4V5Zm4 3a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14",
    title: ko ? "iPhone과 iPad에서 듣는 Mac 소리" : "Hear your Mac",
    text: ko
      ? "연결 설정에서 ‘Mac 오디오 듣기’를 켜면 Mac에서 재생 중인 소리를 iPhone이나 iPad로 들을 수 있습니다."
      : "Turn on Play Mac audio in connection settings to hear what’s playing on your Mac through your iPhone or iPad.",
  },
  {
    icon: "M9 6a3 3 0 0 1 6 0v5a3 3 0 0 1-6 0V6Zm-4 5a7 7 0 0 0 14 0m-7 7v3m-3 0h6",
    title: ko ? "Mac 앱에서 쓰는 내 마이크" : "Bring your microphone",
    text: ko
      ? "twoRT Connect에서 마이크 드라이버를 설치하고 iPhone이나 iPad에서 마이크를 켜세요. Mac 앱에서 twoRT Microphone을 선택하면 내 목소리가 전달됩니다."
      : "Install the microphone driver in twoRT Connect and enable the mic on your iPhone or iPad. Select twoRT Microphone as the input in your Mac app.",
  },
];
---
<section class="container session-features" aria-label={ko ? "오디오와 마이크" : "Audio and microphone"}>
  {features.map(({ icon, title, text }) => (
    <article>
      <svg width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d={icon} />
      </svg>
      <h2>{title}</h2>
      <p>{text}</p>
    </article>
  ))}
</section>

<style>
  .session-features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 4.5vw, 56px);
    padding-block: clamp(38px, 5vw, 65px);
    border-top: 1px solid var(--line);
  }
  svg { color: var(--color-accent-1); margin-bottom: 18px; }
  h2 { margin: 0 0 10px; font-size: 20px; line-height: 1.4; letter-spacing: -.035em; font-weight: 550; }
  p { margin: 0; font-size: 15px; line-height: 1.75; color: var(--muted); }
  @media (max-width: 700px) {
    .session-features { grid-template-columns: 1fr; gap: 28px; }
    article { display: grid; grid-template-columns: 27px 1fr; gap: 4px 14px; }
    svg { grid-row: span 2; margin: 0; }
    h2 { margin: 0; font-size: 18px; }
    p { grid-column: 2; }
  }
</style>
