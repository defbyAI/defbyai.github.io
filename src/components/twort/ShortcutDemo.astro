---
import type { Language } from "../../data/products";

interface Props { lang: Language; }
const { lang } = Astro.props;
const ko = lang === "ko";
const shortcuts = [
  { action: "out", key: "⌘ −", label: ko ? "축소" : "Zoom out" },
  { action: "in", key: "⌘ +", label: ko ? "확대" : "Zoom in" },
  { action: "fit", key: "⌘ 0", label: ko ? "화면에 맞추기" : "Fit to window" },
];
---
<section id="controls" class="container split-section" aria-labelledby="controls-title">
  <div class="section-copy">
    <h2 id="controls-title">
      {ko ? "Mac 단축키를" : "Your Mac shortcuts,"}<br />
      <span>{ko ? "한 번의 탭으로." : "a tap away."}</span>
    </h2>
    <p class="section-body">
      {ko
        ? "twoRT Connect에 자주 쓰는 키 조합을 등록해 두세요. iPhone이나 iPad에서 버튼을 탭하면 Mac에서 해당 단축키가 실행됩니다."
        : "Save a key combination in twoRT Connect. Then tap its button on your iPhone or iPad to run the shortcut on your Mac."}
    </p>
  </div>
  <figure class="shortcut-demo">
    <figcaption>
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="4" width="20" height="16" rx="3" />
        <circle cx="8" cy="9" r="1.3" />
        <path d="m3 17 5-4 3.5 3 4.8-6 5.7 6" />
      </svg>
      <span>{ko ? "사진 단축키 데모" : "Photo shortcut demo"}</span>
      <output data-zoom-label aria-label={ko ? "배율" : "Zoom level"} aria-live="polite">1×</output>
    </figcaption>
    <div class="photo-mat">
      <img
        src="/twort/coast-study.webp"
        alt={ko ? "황토색 해안과 청록색 바다를 위에서 본 모습" : "Aerial view of an ochre coastline and teal water"}
        width="1440" height="960"
        loading="lazy" decoding="async"
      />
    </div>
    <div class="shortcut-row" role="group" aria-label={ko ? "예시 단축키" : "Example shortcuts"} data-zoom-controls hidden>
      {shortcuts.map(({ action, key, label }) => (
        <button type="button" data-zoom-action={action}>
          <kbd aria-hidden="true">{key}</kbd>
          <span>{label}</span>
        </button>
      ))}
    </div>
    <noscript>
      <dl class="shortcut-row shortcut-legend">
        {shortcuts.map(({ key, label }) => (
          <div><dt>{label}</dt><dd><kbd>{key}</kbd></dd></div>
        ))}
      </dl>
    </noscript>
  </figure>
</section>

<style>
  .section-body { margin-bottom: 0; max-width: 30em; }
  .shortcut-demo {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    color-scheme: light dark;
    border: 1px solid light-dark(#ccd2c9, #4b5550);
    border-radius: 18px;
    background: light-dark(#fafbf7, #252b28);
    box-shadow: 0 5px 14px -8px #203b302e;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 14px 18px;
    color: light-dark(#34443b, #e6ece7);
    font-size: 13px;
    font-weight: 600;
  }
  figcaption svg { color: light-dark(var(--color-accent-1), #98bdb4); }
  output {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
    color: light-dark(#5a6961, #b9c6bd);
    font-size: 12px;
    font-weight: 500;
  }
  .photo-mat {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    aspect-ratio: 1.85;
    overflow: hidden;
    padding: 13px;
    background: light-dark(#29332f, #141a17);
  }
  .photo-mat img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    transform: scale(var(--zoom, 1));
    transition: transform 200ms ease-out;
  }
  .shortcut-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 14px;
  }
  .shortcut-row button, .shortcut-legend > div {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 6px;
    min-height: 61px;
    padding: 6px;
    border: 1px solid light-dark(#cdd9d0, #4f5d55);
    border-radius: 9px;
    background: light-dark(#eaf1eb, #36423b);
    color: light-dark(#344239, #e5ece6);
    font-size: 12px;
    line-height: 1.25;
    text-align: center;
  }
  kbd { font: 600 17px/1.1 ui-monospace, monospace; letter-spacing: -0.07em; }
  .shortcut-row button:enabled:hover { border-color: light-dark(#98b5a5, #7e9c88); background: light-dark(#deebe1, #435549); }
  .shortcut-row button:enabled:active { background: light-dark(#cfdfd3, #506456); }
  .shortcut-row button:disabled { color: light-dark(#738076, #a0aba3); background: light-dark(#eef1ec, #2c342f); cursor: default; }
  .shortcut-row button:focus-visible { outline-color: light-dark(var(--color-accent-2), #97baf0); outline-offset: 2px; }
  .shortcut-legend dt { grid-row: 2; }
  .shortcut-legend dd { grid-row: 1; margin: 0; }
  @media (max-width: 480px) {
    .shortcut-row { gap: 5px; padding: 10px; }
    figcaption { padding: 12px; }
    .photo-mat { padding: 10px; }
  }
</style>

<script>
  for (const demo of document.querySelectorAll<HTMLElement>(".shortcut-demo")) {
    const controls = demo.querySelector<HTMLElement>("[data-zoom-controls]");
    const output = demo.querySelector<HTMLOutputElement>("[data-zoom-label]");
    const decrease = demo.querySelector<HTMLButtonElement>('[data-zoom-action="out"]');
    const increase = demo.querySelector<HTMLButtonElement>('[data-zoom-action="in"]');
    const fit = demo.querySelector<HTMLButtonElement>('[data-zoom-action="fit"]');
    if (!controls || !output || !decrease || !increase || !fit) continue;

    const levels = [0.5, 0.75, 1, 1.5, 2, 3];
    const fitted = levels.indexOf(1);
    let level = fitted;

    const setZoom = (index: number) => {
      level = index;
      demo.style.setProperty("--zoom", String(levels[level]));
      output.value = `${levels[level]}×`;
      decrease.disabled = level === 0;
      increase.disabled = level === levels.length - 1;
    };

    decrease.addEventListener("click", () => setZoom(level - 1));
    increase.addEventListener("click", () => setZoom(level + 1));
    fit.addEventListener("click", () => setZoom(fitted));
    controls.hidden = false;
  }
</script>
