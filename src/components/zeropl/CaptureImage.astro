---
import type { DeviceCapture } from "../../data/zeropl-captures";
import type { Language } from "../../data/zeropl";

interface Props {
  capture: DeviceCapture;
  lang: Language;
  priority?: boolean;
}

const { capture, lang, priority = false } = Astro.props;
---
<picture>
  {capture.dark && <source media="(prefers-color-scheme: dark)" srcset={capture.dark} />}
  <img
    class="app-capture"
    src={capture.light}
    width={capture.width}
    height={capture.height}
    alt={capture.alt[lang]}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
  />
</picture>
