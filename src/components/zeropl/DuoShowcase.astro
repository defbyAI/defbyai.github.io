---
import FoldShowcase from "../FoldShowcase.astro";
import { duoPoseCaptures } from "../../data/zeropl-captures";
import { zeropl, type Language } from "../../data/zeropl";
import { foldPoses } from "../../lib/zeropl/fold-preview-poses";

interface Props { lang: Language; standalone?: boolean; }
const { lang, standalone = false } = Astro.props;
const t = zeropl[lang];
const poses = foldPoses.map(frame => {
  const { id } = frame;
  const pose = t.poses.find(pose => pose.id === id);
  const capture = duoPoseCaptures[id];
  if (!pose || !capture) throw new Error(`Missing fold preview pose: ${id}`);
  return { ...pose, frame, capture };
});
---
<FoldShowcase lang={lang} poses={poses} poseGroup={t.poseGroup} poseHint={t.poseHint} standalone={standalone}>
  <slot />
</FoldShowcase>
