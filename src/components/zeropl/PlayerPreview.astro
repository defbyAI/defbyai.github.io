---
import HeroVideo from "../HeroVideo.astro";
import { films } from "../../data/zeropl-media";
import { zeropl, type Language } from "../../data/zeropl";

interface Props { lang: Language; }
const { lang } = Astro.props;
---

<HeroVideo lang={lang} videoId="duo-title-video" label={zeropl[lang].preview} recording={films.cosmos.recording} />
