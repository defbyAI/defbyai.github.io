---
import ProductLayout from "../../layouts/ProductLayout.astro";
import Icon from "./Icon.astro";
import KeylineIcon from "./KeylineIcon.astro";
import CaptureImage from "./CaptureImage.astro";
import PlayerPreview from "./PlayerPreview.astro";
import PlatformComparison from "./PlatformComparison.astro";
import DuoShowcase from "./DuoShowcase.astro";
import TranslationDemo from "./TranslationDemo.astro";
import MediaCredit from "./MediaCredit.astro";
import MediaCredits from "./MediaCredits.astro";
import { captures } from "../../data/zeropl-captures";
import { mediaText } from "../../data/zeropl-media";
import { zeropl, type Language } from "../../data/zeropl";
interface Props { lang: Language; }
const { lang } = Astro.props;
const t = zeropl[lang];
const promiseIcons = ["lock", "sparkles", "laptop-smartphone"];
---
<ProductLayout lang={lang} title={t.title} description={t.description}>
  <a class="skip-link" href="#main">{t.skip}</a>
  <header class="site-header" id="top">
    <div class="header-inner">
      <a class="site-brand" href="/" aria-label="defby.ai"><img src="/defby_logo.svg" width="28" height="28" alt="" />defby.ai</a>
      <span class="header-divider" aria-hidden="true"></span><a class="product-brand" href="#top">zeroPL</a>
      <nav class="product-nav" aria-label={lang === "ko" ? "제품 탐색" : "Product navigation"}><a href="#platforms">{lang === "ko" ? "기기별 화면" : "Device layouts"}</a><a href="#translation">{t.translation}</a><a href="#duo">{t.duo}</a><a href="#features">{t.features}</a></nav>
      <nav class="language-nav" aria-label="Language / 언어"><a href="/zeropl/" lang="en" hreflang="en" aria-current={lang === "en" ? "page" : undefined}>EN</a><span aria-hidden="true">/</span><a href="/ko/zeropl/" lang="ko" hreflang="ko" aria-current={lang === "ko" ? "page" : undefined}>한국어</a></nav>
    </div>
  </header>
  <main id="main">
    <section class="product-hero" aria-labelledby="hero-title">
      <div class="hero-dots" aria-hidden="true"></div>
      <div class="container hero-heading">
        <div class="hero-wordmark"><img src="/zeropl/app-icon.png" width="58" height="58" alt="" /><span>zeroPL</span></div>
        <h1 id="hero-title">{t.hero}</h1>
        <p class="hero-subtitle">{t.heroSubtitle}</p>
        <p class="hero-intro">{t.intro}</p>
        <p class="store-availability">
          <img src="/zeropl/app-store-badge.svg" width="144" height="48" lang="en" alt="App Store" />
          <span class="store-availability-status">{t.storeStatus}</span>
        </p>
        <p class="platform-label">{t.platforms}</p>
      </div>
      <figure class="container hero-preview">
        <PlayerPreview lang={lang} />
        <figcaption><MediaCredit film="cosmos" lang={lang} /></figcaption>
      </figure>
      <div class="container promise-row">
        {t.promise.map((promise, index) => (
          <span>
            <KeylineIcon name={promiseIcons[index]} size={18} />
            {promise}
          </span>
        ))}
      </div>
    </section>

    <PlatformComparison lang={lang} />

    <section class="container split-section ai-section" id="translation" aria-labelledby="ai-title">
      <div class="section-copy"><p class="eyebrow">{t.aiEyebrow}</p><h2 id="ai-title">{t.aiTitle[0]}<br /><span>{t.aiTitle[1]}</span></h2><p class="section-body">{t.aiBody}</p><ul class="benefits">{t.aiPoints.map(point => <li><Icon name="check" size={18} />{point}</li>)}</ul><p class="fine-print">{t.aiNote}</p></div>
      <TranslationDemo lang={lang} />
    </section>

    <section class="duo-section" id="duo" aria-labelledby="duo-title">
      <div class="container">
        <DuoShowcase lang={lang}>
          <p class="eyebrow">{t.duoEyebrow}</p>
          <h2 id="duo-title">{t.duoTitle[0]}<br /><span>{t.duoTitle[1]}</span></h2>
          <p class="section-body">{t.duoBody}</p>
        </DuoShowcase>
        <div class="duo-credits">
          <MediaCredit film="bunny" lang={lang} />
          <a href="/zeropl/fold-preview-notice.txt">Fold Preview · Three.js · MIT</a>
        </div>
      </div>
    </section>

    <section class="container split-section web-section" id="web" aria-labelledby="web-title">
      <figure class="web-demo"><CaptureImage capture={captures.web} lang={lang} />
        <figcaption>{lang === "ko" ? "iPhone Duo의 내장 브라우저와 미니 플레이어" : "Built-in browser and mini-player on iPhone Duo"}
          <MediaCredit film="bunny" lang={lang} />
        </figcaption>
      </figure>
      <div class="section-copy"><p class="eyebrow">{t.webEyebrow}</p><h2 id="web-title">{t.webTitle[0]}<br /><span>{t.webTitle[1]}</span></h2><p class="section-body">{t.webBody}</p></div>
    </section>

    <section class="container features-section" id="features" aria-labelledby="features-title">
      <p class="eyebrow">{t.everyEyebrow}</p>
      <h2 id="features-title">{t.everyTitle}</h2>
      <div class="feature-grid">
        {t.featureList.map(feature => (
          <article>
            <KeylineIcon name={feature.icon} size={29} />
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="container closing"><img src="/zeropl/app-icon.png" alt="zeroPL" width="76" height="76" loading="lazy" /><h2>{t.endTitle}</h2><p>{t.endBody}</p><a class="text-link" href={`/zeropl/privacy#${lang}`}><Icon name="lock" size={15} />{t.privacy}<Icon name="arrow" size={16} /></a></section>
    <MediaCredits lang={lang} />
  </main>
  <footer class="container site-footer"><div><a class="site-brand" href="/"><img src="/defby_logo.svg" alt="" width="24" height="24" />defby.ai</a><p>{t.footerNote}</p></div><div class="footer-links"><a href="#media-credits">{mediaText[lang].credits}</a><a href={`/zeropl/privacy#${lang}`}>{t.privacy}</a><a href="#top">{t.backTop} ↑</a></div></footer>
</ProductLayout>
