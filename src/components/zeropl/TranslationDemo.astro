---
import Icon from "./Icon.astro";
import MediaCredit from "./MediaCredit.astro";
import { films } from "../../data/zeropl-media";
import type { Language } from "../../data/zeropl";

interface Props { lang: Language; }
const { lang } = Astro.props;
const ko = lang === "ko";
const recording = films.sintel.recording;
---
<div class="translation-demo" id="translation-demo">
  <figure class="translation-capture">
    <div class="translation-demo-heading"><span><Icon name="spark" size={16} />English <Icon name="arrow" size={13} /> 한국어</span><span>macOS</span></div>
    <video
      class="translation-video"
      width={recording.width}
      height={recording.height}
      controls
      playsinline
      preload="none"
      poster={recording.poster}
      aria-label={ko ? "Mac의 zeroPL에서 녹화한 Sintel 영상과 한국어 실시간 번역 자막" : "Sintel recorded in zeroPL on macOS with live Korean subtitles"}
    >
      <source src={recording.video} type="video/mp4" />
      <a href={recording.video}>{ko ? "녹화 영상 열기" : "Open recording"}</a>
    </video>
    <figcaption>{ko ? "Mac에서 Sintel을 재생하며 영어 음성과 zeroPL이 화면에 표시한 한국어 번역 자막을 함께 녹화했습니다." : "Recorded in zeroPL on macOS with Sintel’s English dialogue and the Korean subtitles shown by the app."}</figcaption>
  </figure>
  <MediaCredit film="sintel" lang={lang} />
</div>

<script>
  const recording = document.querySelector<HTMLVideoElement>("#translation-demo video");
  document.addEventListener("visibilitychange", () => { if (document.hidden) recording?.pause(); });
</script>
