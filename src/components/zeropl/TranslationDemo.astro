---
import CaptureImage from "./CaptureImage.astro";
import Icon from "./Icon.astro";
import MediaCredit from "./MediaCredit.astro";
import { captures } from "../../data/zeropl-captures";
import { films } from "../../data/zeropl-media";
import type { Language } from "../../data/zeropl";

interface Props { lang: Language; }
const { lang } = Astro.props;
const ko = lang === "ko";
const film = films.sintel;
---
<div class="translation-demo" id="translation-demo">
  <figure class="translation-capture">
    <div class="translation-demo-heading"><span><Icon name="spark" size={16} />English <Icon name="arrow" size={13} /> 한국어</span><span>iPhone Duo</span></div>
    <CaptureImage capture={captures.translation} lang={lang} />
    <figcaption>{ko ? "zeroPL이 Sintel의 영어 음성에서 생성한 한국어 자막." : "Korean subtitles generated by zeroPL from Sintel’s English dialogue."}</figcaption>
  </figure>
  <MediaCredit film="sintel" lang={lang} />
  <details class="demo-transcript">
    <summary>{ko ? "Sintel의 원본 대화 재생" : "Play the original Sintel dialogue"}</summary>
    <video class="translation-video" controls playsinline preload="none" poster={film.poster} aria-label={ko ? "Sintel의 영어 대화 발췌, 19초" : "Excerpt of Sintel’s English dialogue, 19 seconds"}>
      <source src={film.video} type="video/mp4" />
      <a href={film.video}>{ko ? "영상 파일 열기" : "Open video file"}</a>
    </video>
  </details>
</div>

<script>
  const details = document.querySelector<HTMLDetailsElement>("#translation-demo details");
  const excerpt = details?.querySelector("video");
  details?.addEventListener("toggle", () => { if (!details.open) excerpt?.pause(); });
  document.addEventListener("visibilitychange", () => { if (document.hidden) excerpt?.pause(); });
</script>
