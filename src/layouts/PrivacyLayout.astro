---
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  shareTitle: string;
  shareDescription: string;
  shareImage?: string;
  contactEmail: string;
}
const { title, description, canonical, shareTitle, shareDescription, shareImage, contactEmail } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F6F6F1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="defby.ai" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={canonical} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Asta+Sans:wght@300;400;500;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" lang="ko" href="#ko-body">처리방침으로 바로 가기</a>
    <a class="skip-link" lang="en" href="#en-body">Skip to policy</a>
    <div class="page" id="top">
      <div id="ko-top"></div>
      <div id="en-top"></div>
      <header>
        <a class="brand" href="/" aria-label="defby.ai home">
          <img src="/defby_logo.svg" width="36" height="36" alt="" />
          <span>defby.ai</span>
        </a>
        <nav class="language-nav" aria-label="Language / 언어">
          <a href="#ko" lang="ko" hreflang="ko" data-language="ko">한국어</a>
          <span aria-hidden="true">/</span>
          <a href="#en" lang="en" hreflang="en" data-language="en">English</a>
          <a href={Astro.url.pathname} data-auto-language hidden>자동</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer>
        <div><p data-contact>개인정보 관련 문의</p><a href={`mailto:${contactEmail}`}>{contactEmail}</a></div>
        <a class="back-top" href="#top" data-top>맨 위로<span aria-hidden="true"> ↑</span></a>
      </footer>
    </div>
    <slot name="script" />
    <script>
      import { browserLanguage, preferredLanguage, rememberLanguage, savedLanguage } from "../lib/language";
      import type { Language } from "../data/products";

      const links = document.querySelectorAll<HTMLAnchorElement>("[data-language]");
      const automatic = document.querySelector<HTMLAnchorElement>("[data-auto-language]")!;
      const content = document.querySelectorAll<HTMLElement>("[data-policy], [data-policy-copy], .skip-link");
      const contact = document.querySelector<HTMLElement>("[data-contact]")!;
      const top = document.querySelector<HTMLAnchorElement>("[data-top]")!;

      function showLanguage(language: Language) {
        document.documentElement.lang = language;
        content.forEach(element => { element.hidden = element.lang !== language; });
        links.forEach(link => {
          if (link.lang === language) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        });
        const ko = language === "ko";
        contact.textContent = ko ? "개인정보 관련 문의" : "Privacy questions";
        top.textContent = ko ? "맨 위로 ↑" : "Back to top ↑";
        top.hash = language + "-top";
        automatic.textContent = ko ? "자동" : "Auto";
        automatic.title = ko ? "브라우저 언어 사용" : "Use browser language";
        automatic.search = location.search;
        automatic.hidden = !savedLanguage() && language === browserLanguage();
        document.dispatchEvent(new CustomEvent("policy-language-change", { detail: language }));
      }

      function syncLocation() {
        const anchor = location.hash.match(/^#(ko|en)(?:-|$)/)?.[1];
        const target = document.getElementById(location.hash.slice(1));
        const wasHidden = target?.closest<HTMLElement>("[data-policy]")?.hidden;
        showLanguage(anchor === "ko" || anchor === "en" ? anchor : preferredLanguage());
        if (wasHidden) target?.scrollIntoView();
      }

      [...links, automatic].forEach(link => link.addEventListener("click", event => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        rememberLanguage(link.lang === "ko" || link.lang === "en" ? link.lang : null);
        if (location.href !== link.href) history.pushState(null, "", link.href);
        syncLocation();
      }));
      window.addEventListener("hashchange", syncLocation);
      window.addEventListener("languagechange", syncLocation);
      window.addEventListener("pageshow", syncLocation);
      window.addEventListener("storage", syncLocation);
      syncLocation();
    </script>
  </body>
</html>

<style is:global>
  :root { --bg: var(--color-bg); --text: var(--color-text); --muted: var(--color-muted); --accent: var(--color-accent-2); --line: var(--color-line); }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--bg); }
  body { margin: 0; color: var(--text); background: var(--bg); font-family: "Asta Sans", "Helvetica Neue", Arial, sans-serif; -webkit-font-smoothing: antialiased; }
  a { color: var(--accent); text-underline-offset: 5px; }
  a:hover { color: var(--color-accent-2-active); }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; border-radius: 2px; }
  [hidden] { display: none !important; }
  .page { width: min(1120px, 100% - 96px); margin: 0 auto; }
  .skip-link { position: absolute; top: -100px; left: 24px; z-index: 10; padding: 12px; background: var(--bg); }
  .skip-link:focus { top: 12px; }
  header { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 36px 0; }
  .brand { display: inline-flex; align-items: center; gap: 12px; color: var(--color-brand-text); text-decoration: none; }
  .brand img { display: block; }
  .brand span { font-size: 25px; font-weight: 700; letter-spacing: -0.035em; }
  .language-nav { display: flex; align-items: center; gap: 14px; font-size: 13px; }
  .language-nav a { color: var(--muted); text-decoration: none; padding: 10px 0; }
  .language-nav a[aria-current] { color: var(--color-accent-2-active); text-decoration: underline; font-weight: 500; }
  .language-nav a:hover { color: var(--color-accent-2-active); text-decoration: underline; }
  .language-nav span { color: #9da8a4; }
  .hero { position: relative; padding: 80px 0 52px; isolation: isolate; }
  .hero-dots { position: absolute; z-index: -1; top: 12px; right: -24px; width: 50%; height: 310px; opacity: 0.22; background-image: radial-gradient(var(--color-accent-1) 0.9px, transparent 0.9px), radial-gradient(var(--color-accent-1) 0.7px, transparent 0.7px); background-size: 29px 31px, 43px 47px; background-position: 0 0, 12px 17px; mask-image: linear-gradient(90deg, transparent, black); pointer-events: none; }
  .product { margin: 0 0 26px; color: var(--accent); font-size: 15px; font-weight: 500; }
  .product span { margin-left: 16px; color: var(--muted); font-size: 12px; font-weight: 400; }
  h1 { margin: 0 0 28px; font-size: clamp(36px, 4.8vw, 60px); line-height: 1.3; font-weight: 500; letter-spacing: -0.045em; word-break: keep-all; }
  .intro { max-width: 635px; margin: 0; font-size: 17px; font-weight: 400; line-height: 1.9; word-break: keep-all; }
  .effective-date { display: flex; gap: 12px; margin: 24px 0 0; font-size: 12px; color: var(--muted); }
  .principles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; padding: 32px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .principle-marker { color: var(--accent); font-size: 12px; font-variant-numeric: tabular-nums; }
  .principles h2 { margin: 12px 0 10px; font-size: 19px; font-weight: 500; letter-spacing: -0.02em; }
  .principles p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.85; word-break: keep-all; }
  .network-note { max-width: 760px; margin: 20px 0 76px; font-size: 13px; line-height: 1.85; color: var(--muted); word-break: keep-all; }
  #policy { scroll-margin-top: 28px; }
  footer { display: flex; justify-content: space-between; align-items: end; gap: 24px; padding: 48px 0 40px; margin-top: 24px; }
  footer p { margin: 0 0 8px; color: var(--muted); font-size: 13px; }
  footer a { font-size: 14px; }
  .back-top { white-space: nowrap; text-decoration: none; }
  @media (max-width: 850px) { .page { width: calc(100% - 64px); } .hero { padding-top: 54px; } .principles { gap: 24px; } }
  @media (max-width: 600px) {
    .page { width: calc(100% - 40px); }
    header { padding: 24px 0; gap: 16px; }
    .brand { gap: 8px; }
    .brand img { width: 29px; height: 29px; }
    .brand span { font-size: 22px; }
    .language-nav { gap: 10px; font-size: 12px; }
    .hero { padding: 48px 0 36px; }
    .hero-dots { width: 85%; right: 0; }
    h1 { font-size: clamp(30px, 7vw, 40px); }
    .intro { font-size: 15px; }
    .principles { grid-template-columns: 1fr; gap: 26px; padding: 28px 0; }
    .principles h2 { margin-top: 8px; }
    .network-note { margin-bottom: 52px; }
    footer { align-items: start; padding-top: 36px; }
  }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  @media print {
    :root { --bg: white; --text: black; --muted: #333; }
    .page { width: 100%; }
    .hero-dots, .language-nav, .skip-link, .back-top { display: none; }
    .hero { padding-top: 20px; }
    .network-note { margin-bottom: 36px; }
    a, a:hover { color: inherit; }
  }
</style>
