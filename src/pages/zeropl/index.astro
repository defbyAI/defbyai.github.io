---
import ProductPage from "../../components/zeropl/ProductPage.astro";
---
<ProductPage lang="en">
  <Fragment slot="head">
    <script>
      import { preferredLanguage, productPaths } from "../../lib/zeropl/language";

      const destination = new URL(location.href);
      destination.pathname = productPaths[preferredLanguage()];
      location.replace(destination.href);
    </script>
  </Fragment>
</ProductPage>
