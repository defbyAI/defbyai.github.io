---
import PrivacyDocument from "../../components/PrivacyDocument.astro";
import policy from "../../data/zeropl-privacy.json";

const effectiveDates = {
  ko: new Intl.DateTimeFormat("ko-KR", { dateStyle: "long", timeZone: "UTC" }).format(new Date(policy.effectiveDate + "T00:00:00Z")),
  en: new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" }).format(new Date(policy.effectiveDate + "T00:00:00Z"))
};

const copy = {
  ko: {
    headline: ["로컬에 저장하고,", "기기 안에서 처리합니다."],
    description: "zeroPL이 저장하는 재생 데이터는 사용자의 기기에 머뭅니다. 자동 번역도 기기 내 AI 엔진을 사용하며, 영상·음성·자막을 클라우드 AI로 전송하지 않습니다.",
    principles: [
      { label: "로컬 저장", text: "설정, 재생 기록, 자막과 번역 결과를 기기에 저장합니다." },
      { label: "기기 내 AI", text: "음성 인식, 번역, 자막 다듬기를 기기 안에서 처리합니다." },
      { label: "자동 전송 없음", text: "광고·추적·이용 분석과 오류 보고 자동 전송 기능이 없습니다." }
    ],
    network: "사용자가 선택한 미디어 서버 연결, 언어·모델 파일 다운로드, 외부 링크와 이메일에는 통신이 발생할 수 있습니다. 자세한 범위는 아래 처리방침을 확인해주세요.",
    dateLabel: "시행일", date: effectiveDates.ko, contact: "개인정보 관련 문의", top: "맨 위로"
  },
  en: {
    headline: ["Stored locally.", "Processed on device."],
    description: "The playback data zeroPL saves stays on your device. Automatic translation uses on-device AI engines, without sending video, audio, or subtitles to cloud AI services.",
    principles: [
      { label: "Local storage", text: "Settings, playback history, subtitles, and translation results stay on your device." },
      { label: "On-device AI", text: "Speech recognition, translation, and subtitle refinement run on your device." },
      { label: "No automatic uploads", text: "No advertising, tracking, usage analytics, or automatic crash reporting." }
    ],
    network: "Connections to media servers you choose, language and model downloads, external links, and email can involve network communication. The policy below explains their scope.",
    dateLabel: "Effective date", date: effectiveDates.en, contact: "Privacy questions", top: "Back to top"
  }
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>zeroPL 개인정보 처리방침 · Privacy Policy — defby.ai</title>
    <meta name="description" content="zeroPL의 로컬 저장과 기기 내 AI 처리 원칙. iPhone, iPad, Mac용 개인정보 처리방침 / Privacy policy for zeroPL." />
    <link rel="canonical" href={policy.websiteURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="defby.ai" />
    <meta property="og:title" content="zeroPL Privacy Policy" />
    <meta property="og:description" content="Stored locally. Processed on device. Read zeroPL’s privacy policy in Korean and English." />
    <meta property="og:url" content={policy.websiteURL} />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Asta+Sans:wght@100;200;300;400;500;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#policy">처리방침으로 바로 가기 / Skip to policy</a>
    <div class="page" id="top">
      <header>
        <a class="brand" href="/" aria-label="defby.ai home">
          <img src="/defby_logo.svg" width="36" height="36" alt="" />
          <span>defby.ai</span>
        </a>
        <nav class="language-nav" aria-label="Language / 언어">
          <a href="#ko" lang="ko" data-language="ko" aria-current="true">한국어</a>
          <span aria-hidden="true">/</span>
          <a href="#en" lang="en" data-language="en">English</a>
        </nav>
      </header>
      <main>
        <section class="hero" aria-label="zeroPL privacy">
          <div class="hero-dots" aria-hidden="true"></div>
          <p class="product">zeroPL <span>iPhone · iPad · Mac</span></p>
          <h1 data-headline>{copy.ko.headline[0]}<br />{copy.ko.headline[1]}</h1>
          <p class="intro" data-description>{copy.ko.description}</p>
          <p class="effective-date"><span data-date-label>{copy.ko.dateLabel}</span> <time datetime={policy.effectiveDate} data-date>{copy.ko.date}</time></p>
        </section>
        <div class="principles" aria-label="Privacy principles">
          {copy.ko.principles.map((principle, index) => (
            <div>
              <span class="principle-marker" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <h2 data-principle-label={index}>{principle.label}</h2>
              <p data-principle-text={index}>{principle.text}</p>
            </div>
          ))}
        </div>
        <p class="network-note" data-network>{copy.ko.network}</p>
        <div id="policy">
          <PrivacyDocument language="ko" {...policy.translations.ko} />
          <PrivacyDocument language="en" {...policy.translations.en} />
        </div>
      </main>
      <footer>
        <div><p data-contact>{copy.ko.contact}</p><a href={`mailto:${policy.contactEmail}`}>{policy.contactEmail}</a></div>
        <a class="back-top" href="#top" data-top>{copy.ko.top}<span aria-hidden="true"> ↑</span></a>
      </footer>
    </div>
    <script define:vars={{ copy }}>
      // Both complete policies remain readable when JavaScript is unavailable.
      const languageLinks = document.querySelectorAll("[data-language]");
      const documents = document.querySelectorAll("[data-policy]");
      const setText = (selector, text) => {
        const element = document.querySelector(selector);
        if (element) element.textContent = text;
      };
      const languageFromHash = () => /^#en(?:-|$)/.test(window.location.hash) ? "en" : "ko";
      const showLanguage = (language) => {
        const text = copy[language];
        document.documentElement.lang = language;
        documents.forEach((article) => { article.hidden = article.id !== language; });
        languageLinks.forEach((link) => {
          if (link.dataset.language === language) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        });
        const headline = document.querySelector("[data-headline]");
        headline.replaceChildren(document.createTextNode(text.headline[0]), document.createElement("br"), document.createTextNode(text.headline[1]));
        setText("[data-description]", text.description);
        setText("[data-network]", text.network);
        setText("[data-date-label]", text.dateLabel);
        setText("[data-date]", text.date);
        setText("[data-contact]", text.contact);
        setText("[data-top]", text.top + " ↑");
        text.principles.forEach((principle, index) => {
          setText(`[data-principle-label="${index}"]`, principle.label);
          setText(`[data-principle-text="${index}"]`, principle.text);
        });
      };
      languageLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          history.pushState(null, "", link.getAttribute("href"));
          showLanguage(link.dataset.language);
        });
      });
      window.addEventListener("hashchange", () => {
        const target = document.getElementById(window.location.hash.slice(1));
        const language = target?.closest("[data-policy]")?.id;
        if (language) showLanguage(language);
        if (/^#(?:ko|en)$/.test(window.location.hash)) showLanguage(languageFromHash());
      });
      window.addEventListener("popstate", () => {
        if (/^#(?:ko|en)(?:-|$)/.test(window.location.hash)) showLanguage(languageFromHash());
      });
      showLanguage(languageFromHash());
    </script>
  </body>
</html>

<style is:global>
  :root { --bg: #efefef; --text: #505453; --muted: #636b68; --accent: #466e68; --line: #cfd7d3; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; background: var(--bg); }
  body { margin: 0; color: var(--text); background: var(--bg); font-family: "Asta Sans", "Helvetica Neue", Arial, sans-serif; -webkit-font-smoothing: antialiased; }
  a { color: var(--accent); text-underline-offset: 5px; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; border-radius: 2px; }
  ::selection { background: #cddfda; color: #2c4843; }
  [hidden] { display: none !important; }
  .page { width: min(1120px, 100% - 96px); margin: 0 auto; }
  .skip-link { position: absolute; top: -100px; left: 24px; z-index: 10; padding: 12px; background: var(--bg); }
  .skip-link:focus { top: 12px; }
  header { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 36px 0; }
  .brand { display: inline-flex; align-items: center; gap: 12px; color: #5f5f5f; text-decoration: none; }
  .brand img { display: block; }
  .brand span { font-size: 25px; font-weight: 700; letter-spacing: -0.035em; }
  .language-nav { display: flex; align-items: center; gap: 14px; font-size: 13px; }
  .language-nav a { color: var(--muted); text-decoration: none; padding: 10px 0; }
  .language-nav a[aria-current] { color: var(--accent); text-decoration: underline; font-weight: 500; }
  .language-nav span { color: #9da8a4; }
  .hero { position: relative; padding: 80px 0 52px; isolation: isolate; }
  .hero-dots { position: absolute; z-index: -1; top: 12px; right: -24px; width: 50%; height: 310px; opacity: 0.4; background-image: radial-gradient(#a5b9b0 0.9px, transparent 0.9px), radial-gradient(#a5b9b0 0.7px, transparent 0.7px); background-size: 29px 31px, 43px 47px; background-position: 0 0, 12px 17px; mask-image: linear-gradient(90deg, transparent, black); pointer-events: none; }
  .product { margin: 0 0 26px; color: var(--accent); font-size: 15px; font-weight: 500; }
  .product span { margin-left: 16px; color: var(--muted); font-size: 12px; font-weight: 400; }
  h1 { margin: 0 0 28px; font-size: clamp(36px, 4.8vw, 60px); line-height: 1.3; font-weight: 500; letter-spacing: -0.045em; word-break: keep-all; }
  .intro { max-width: 635px; margin: 0; font-size: 17px; font-weight: 400; line-height: 1.9; word-break: keep-all; }
  .effective-date { display: flex; gap: 12px; margin: 24px 0 0; font-size: 12px; color: var(--muted); }
  .principles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; padding: 32px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .principle-marker { color: var(--accent); font-size: 12px; font-variant-numeric: tabular-nums; }
  .principles h2 { margin: 12px 0 10px; font-size: 19px; font-weight: 500; letter-spacing: -0.02em; }
  .principles p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.85; word-break: keep-all; }
  .network-note { max-width: 760px; margin: 20px 0 76px; font-size: 13px; line-height: 1.85; color: var(--muted); word-break: keep-all; }
  #policy { scroll-margin-top: 28px; }
  footer { display: flex; justify-content: space-between; align-items: end; gap: 24px; padding: 48px 0 40px; margin-top: 24px; }
  footer p { margin: 0 0 8px; color: var(--muted); font-size: 13px; }
  footer a { font-size: 14px; }
  .back-top { white-space: nowrap; text-decoration: none; }
  @media (max-width: 850px) { .page { width: calc(100% - 64px); } .hero { padding-top: 54px; } .principles { gap: 24px; } }
  @media (max-width: 600px) {
    .page { width: calc(100% - 40px); }
    header { padding: 24px 0; gap: 16px; }
    .brand { gap: 8px; }
    .brand img { width: 29px; height: 29px; }
    .brand span { font-size: 22px; }
    .language-nav { gap: 10px; font-size: 12px; }
    .hero { padding: 48px 0 36px; }
    .hero-dots { width: 85%; right: 0; }
    h1 { font-size: clamp(30px, 7vw, 40px); }
    .intro { font-size: 15px; }
    .principles { grid-template-columns: 1fr; gap: 26px; padding: 28px 0; }
    .principles h2 { margin-top: 8px; }
    .network-note { margin-bottom: 52px; }
    footer { align-items: start; padding-top: 36px; }
  }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  @media print {
    :root { --bg: white; --text: black; --muted: #333; }
    .page { width: 100%; }
    .hero-dots, .language-nav, .skip-link, .back-top { display: none; }
    .hero { padding-top: 20px; }
    .network-note { margin-bottom: 36px; }
    a { color: inherit; }
  }
</style>
